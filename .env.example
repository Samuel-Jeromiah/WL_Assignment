# -- Postgres (Neon) ---------------------------------------------------------
# Create a free project at https://neon.tech, then paste its connection string.
# Use the POOLED string and append ?sslmode=require. Note the +psycopg driver.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional: a SELECT-only Neon role for the LLM query path. Leave blank to reuse
# DATABASE_URL (the SQL guard + statement_timeout still protect read-only access).
DATABASE_URL_READONLY=

# -- LLM (Groq) --------------------------------------------------------------
# Free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -- PubMed / NCBI E-utilities (only needed to seed the DB via src/etl.py) -----
PUBMED_EMAIL=your.email@example.com
PUBMED_API_KEY=                 # optional - raises rate limit from 3/s to 10/s
PUBMED_TOPIC="cancer immunotherapy"
PUBMED_MAX_ARTICLES=200
PUBMED_REQUIRE_ABSTRACT=true    # filter to articles that have abstracts only
