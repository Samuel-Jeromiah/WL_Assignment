# Postgres connections
# Passwords match the defaults in sql/setup_db.sql — fine for local dev only.
# Change BOTH this file and sql/setup_db.sql before deploying anywhere shared.
# pubmed_user has full read/write on app schema; pubmed_readonly is for LLM-generated SQL
DATABASE_URL=postgresql+psycopg://pubmed_user:pubmed_pass@localhost:5432/pubmed_db
DATABASE_URL_READONLY=postgresql+psycopg://pubmed_readonly:readonly_pass@localhost:5432/pubmed_db

# PubMed / NCBI E-utilities
PUBMED_EMAIL=your.email@example.com
PUBMED_API_KEY=                 # optional — raises rate limit from 3/s to 10/s
PUBMED_TOPIC="cancer immunotherapy"
PUBMED_MAX_ARTICLES=200
PUBMED_REQUIRE_ABSTRACT=true    # filter to articles that have abstracts only

# LLM (local via Ollama)
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_HOST=http://localhost:11434
